# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
venv/
env/
ENV/

# IDE and Editor files
.vscode/
.idea/
.claude/
*.swp
*.swo
*~
.DS_Store

# Data directories
data/raw/
data/processed/*.duckdb
*.accdb
*.mdb
CSV_Files/

# VisionTrain directory (large training data ~31 GB)
VisionTrain/

# Keep VisionTrain scripts tracked, but ignore data
!VisionTrain/*.py
!VisionTrain/*.md
!VisionTrain/*.txt
# Exclude training data and models
VisionTrain/dataset/
VisionTrain/training_data/
VisionTrain/inference_results/
VisionTrain/**/*.pt
VisionTrain/**/*.zip
VisionTrain/**/*.onnx
VisionTrain/**/*.h5
VisionTrain/**/*.hdf5
VisionTrain/**/*.pkl
VisionTrain/**/*.pth
VisionTrain/**/*.ckpt
VisionTrain/**/*.safetensors

# Documentation folders (merged docs/ and documentation/)
docs/*.pdf
docs/*.mp4
docs/*.mov
docs/**/*.pdf
docs/**/*.mp4
docs/**/*.mov

# Root-level models directory - DO NOT COMMIT MODELS
models/
models/**/*

# Jupyter Notebooks
.ipynb_checkpoints/
*.ipynb

# Logs and temporary files
*.log
logs/
tmp/
temp/
reports/

# Environment and configuration
.env
.env.local
*.ini
secrets.toml


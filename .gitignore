# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
venv/
env/
ENV/

# IDE and Editor files
.vscode/
.idea/
.claude/
*.swp
*.swo
*~
.DS_Store

# Data directories
data/raw/
data/processed/*.duckdb
*.accdb
*.mdb
CSV_Files/


# VisionTrain directory (large training data ~31 GB)
VisionTrain/

# Keep VisionTrain scripts tracked, but ignore data
!VisionTrain/*.py
!VisionTrain/*.md
!VisionTrain/*.txt
# Exclude training data and models
VisionTrain/dataset/
VisionTrain/training_data/
VisionTrain/inference_results/
VisionTrain/*.pt
VisionTrain/*.zip

# Documentation folder is tracked
# But exclude any large PDFs or videos
documentation/*.pdf
documentation/*.mp4
documentation/*.mov

# Keep production model in server/
# server/best.pt should be tracked (40.5 MB - needed for production)

# Keep cleaned_data and bird_data.db (essential for project)
# *.csv (commented out - we need cleaned_data/*.csv)
# *.db (commented out - we need bird_data.db)

# Jupyter Notebooks
.ipynb_checkpoints/
*.ipynb

# Logs and temporary files
*.log
logs/
tmp/
temp/

# Environment and configuration
.env
.env.local
*.ini
secrets.toml

# Package manager files
uv.lock
poetry.lock
Pipfile.lock

# OS-specific
Thumbs.db
.DS_Store

# Streamlit
.streamlit/secrets.toml

# Test coverage
.coverage
htmlcov/
.pytest_cache/

# DuckDB specific
*.wal
*.tmp

.claude/

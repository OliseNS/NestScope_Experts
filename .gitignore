# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
venv/
env/
ENV/

# IDE and Editor files
.vscode/
.idea/
.claude/
*.swp
*.swo
*~
.DS_Store

# Data directories
data/raw/
data/processed/*.duckdb
*.accdb
*.mdb
CSV_Files/

# VisionTrain directory (large training data ~31 GB)
VisionTrain/

# Keep VisionTrain scripts tracked, but ignore data
!VisionTrain/*.py
!VisionTrain/*.md
!VisionTrain/*.txt
# Exclude training data and models
VisionTrain/dataset/
VisionTrain/training_data/
VisionTrain/inference_results/
VisionTrain/**/*.pt
VisionTrain/**/*.zip
VisionTrain/**/*.onnx
VisionTrain/**/*.h5
VisionTrain/**/*.hdf5
VisionTrain/**/*.pkl
VisionTrain/**/*.pth
VisionTrain/**/*.ckpt
VisionTrain/**/*.safetensors

# Documentation folders (merged docs/ and documentation/)
docs/*.pdf
docs/*.mp4
docs/*.mov
docs/**/*.pdf
docs/**/*.mp4
docs/**/*.mov

# Root-level models directory - DO NOT COMMIT MODELS
models/
models/**/*

# Jupyter Notebooks
.ipynb_checkpoints/
*.ipynb

# Logs and temporary files
*.log
logs/
tmp/
temp/

# Environment and configuration
.env
.env.local
*.ini
secrets.toml

# Package manager files
uv.lock
poetry.lock
Pipfile.lock

# OS-specific
Thumbs.db
.DS_Store

# Streamlit
.streamlit/secrets.toml

# Test coverage
.coverage
htmlcov/
.pytest_cache/

# DuckDB specific
*.wal
*.tmp

.claude/
labeller/nestvision/images
labeller/nestvision/labels
labeller/nestvision/crops/
labeller/nestvision/*.csv
labeller/project_state.json

# Model files (all formats) - Global exclusion
*.pt
*.pth
*.ckpt
*.h5
*.hdf5
*.pkl
*.pickle
*.onnx
*.pb
*.tflite
*.safetensors
*.msgpack
*.bin

# Large archive files
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# NestScope / nexus_project — https://github.com/OliseNS/nexus_project

# OpenRouter API Configuration
OPENROUTER_API_KEY=your-api-key-here

# Model Configuration
# Default model for natural language queries
# Options: anthropic/claude-sonnet-4.5, google/gemini-3-flash-preview, anthropic/claude-opus-4.5, etc.
# See https://openrouter.ai/models for available models
MODEL_NAME=anthropic/claude-sonnet-4.5

# Database Configuration
DB_PATH=data/bird_data_complete.db
DB_TYPE=sqlite

# Nestperts / OAuth (port 5000 expert tools)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# SECRET_KEY=long-random-string-for-flask-sessions
#
# Local auth database (SQLite) — approved emails, users, roles, root admin
# Default: data/user_auth.db under the repo root
# AUTH_DB_PATH=data/user_auth.db
#
# Optional: bootstrap root admin from env on first init_auth_db() (same effect as seed_root_admin.py)
# ROOT_ADMIN_EMAIL=you@example.com

# API Configuration (optional)
API_BASE_URL=http://localhost:8000

# Docker (see DOCKER.md) — when using docker-compose, set paths inside the container:
# DB_PATH=/app/data/bird_data_complete.db
# AUTH_DB_PATH=/app/data/user_auth.db
# Optional host port overrides: API_PORT=8000 NESTPERTS_PORT=5000

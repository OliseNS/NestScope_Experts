# OpenRouter API Key (REQUIRED for NestChat)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-api-key-here

# Database path (relative to this directory)
DB_PATH=data/bird_data_complete.db

# Optional: Override model (defaults to config.yaml setting)
# MODEL_NAME=anthropic/claude-sonnet-4-5

# Server port (Railway will set this automatically)
# Single unified server serves both API and webapp
PORT=8000
